
digraph finite_state_machine {
	fontname="Helvetica,Arial,sans-serif"
	node [fontname="Helvetica,Arial,sans-serif"]
	edge [fontname="Helvetica,Arial,sans-serif"]
	rankdir=LR;
	node [shape = doublecircle]; assert interim_conclusion;
	node [shape = circle];
	
	start -> propose; 
	start -> assert; 
	
	propose -> propose; 
	propose -> undermine; 
	propose -> alternative; 
	propose -> interim_conclusion; 
	propose -> assert; 
	
	undermine -> undermine; 
	undermine -> propose; 
	undermine -> alternative; 
	undermine -> interim_conclusion;
	undermine -> assert; 
	
	alternative -> propose; 
	alternative -> undermine; 
	alternative -> interim_conclusion;
	alternative -> assert; 
	
	assert -> propose; 
	assert -> alternative; 
	assert -> undermine; 
	
}
